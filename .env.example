# AnimeDesk environment example
#
# Copy to `.env` only if you want to override defaults. AnimeDesk itself does
# not read `.env`; the development launcher and the scripts read process
# environment variables. Nothing here is a secret.

# Loopback port for the local service. 0 = pick a free port automatically.
ANIMEDESK_PORT=0

# Override the application data directory (settings, history, skip ranges).
# Default: %APPDATA%\AnimeDesk
# ANIMEDESK_DATA_DIR=C:\path\to\data

# `distribution` enables the local-only release profile.
# ANIMEDESK_PROFILE=distribution

# Absolute path to a player binary if you do not use tools\mpv\mpv.exe.
# ANIMEDESK_MPV_PATH=C:\path\to\mpv.exe

# Browser executable used for UI tests and the app window.
# ANIMEDESK_BROWSER=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
