{
  "$schema": "https://opencode.ai/config.json",
  "model": "aurora/qwen3-coder-480b-a35b-instruct-turbo",
  "share": "disabled",
  "providers": {
    "aurora": {
      "name": "Aurora (AnimeDesk)",
      "env": ["GEN_LLM_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:GEN_LLM_BASE_URL}",
        "encoding": "none"
      },
      "models": {
        "qwen3-coder-480b-a35b-instruct-turbo": {
          "name": "Qwen3 Coder 480B A35B Instruct Turbo (Aurora)",
          "modelID": "aurora/qwen3-coder-480b-a35b-instruct-turbo",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    },
    "gen": {
      "name": "Gen (AnimeDesk fallback)",
      "env": ["GEN_LLM_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:GEN_LLM_BASE_URL}",
        "encoding": "none"
      },
      "models": {
        "deepseek-v4.1-flash-free": {
          "name": "DeepSeek v4.1 Flash Free",
          "modelID": "deepseek-v4.1-flash-free",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "aurora", "effect": "allow" },
    { "action": "provider.use", "resource": "gen", "effect": "allow" }
  ]
}
