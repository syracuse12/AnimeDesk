{
  "name": "animedesk",
  "private": true,
  "version": "0.2.4",
  "description": "Lightweight Windows anime desk: search, episodes, dub/sub, mpv playback and automatic next-episode progression.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node scripts/launch.mjs",
    "server": "node server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"tests/*.test.ts\"",
    "test:ui": "node tests/ui.mjs",
    "test:qa-ux": "node tests/qa-ux.mjs",
    "test:live": "node tests/live.mjs",
    "test:aniskip": "node tests/aniskip-map.mjs",
    "test:autoplay": "node tests/autoplay.mjs",
    "test:persistence": "node tests/persistence.mjs",
    "test:continue": "node tests/continue-watching.mjs",
    "test:layout": "node tests/layout.mjs",
    "test:mpv": "node tests/mpv-fallback.mjs",
    "test:screens": "node tests/screens.mjs",
    "test:qa": "node tests/aniskip-map.mjs && node tests/autoplay.mjs && node tests/persistence.mjs && node tests/mpv-fallback.mjs && node tests/screens.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "setup:mpv": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-mpv.ps1"
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
